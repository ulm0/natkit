# natkit kernel options for EC2 Graviton (arm64), after natkit.config (kernel/build.sh)

# the UKI needs an uncompressed PE kernel (EFI_STUB, `linuxkit build --decompress-kernel`), not EFI_ZBOOT
CONFIG_EFI_ZBOOT=n

# hardening / performance on Graviton
CONFIG_ARM64_PAN=y
CONFIG_ARM64_USE_LSE_ATOMICS=y

# interrupts: GICv3 with ITS for PCIe MSI-X
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_PCI_HOST_GENERIC=y

# the UART comes from ACPI SPCR. uncertain: 16550-compatible vs PL011 (yagan enables both too)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# clock: the EFI runtime RTC
CONFIG_RTC_DRV_EFI=y
