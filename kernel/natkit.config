# natkit kernel option list over 'make allnoconfig', both architectures (then natkit-<arch>.config; kernel/build.sh sets
# each line with scripts/config, runs olddefconfig and fails if a line didn't apply). Not a delta on LinuxKit's config.
# Started from yagan's (github.com/ulm0/yagan, kernel/yagan.config) without k3s, Cilium and the Lima/VZ devices.
# Comments go on their own lines: build.sh would read a trailing one into the value.

# LinuxKit kernel Dockerfile: modules_install + Module.symvers need MODULES (Jool's NAT64 modules load at boot)
CONFIG_MODULES=y
CONFIG_LOCALVERSION="-linuxkit"

# core userspace basics (most are on anyway while EXPERT=n; listed so a dropped one fails the build check)
CONFIG_EXPERT=n
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# timers: hrtimers for nanosleep/timerfd; tickless idle
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# UEFI boot (systemd-boot + a UKI, LinuxKit's raw-efi), hardware described by ACPI on both EC2 architectures
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_DMIID=y
# the root filesystem is LinuxKit's gzip initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# PCIe: Nitro attaches ENIs (the static ENI, eni_id) and EBS volumes at runtime by PCIe hotplug
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y

# EBS (the root volume) is NVMe
CONFIG_BLOCK=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EFI_PARTITION=y

# ENA network interface
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
CONFIG_WLAN=n

# serial console (EC2 console output, the serial console getty)
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# rngd
CONFIG_HW_RANDOM=y

# clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_HCTOSYS=y

# instance stop/terminate: ACPI power button -> evdev -> acpid
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_BUTTON=y
CONFIG_KEYBOARD_ATKBD=n
CONFIG_USB_SUPPORT=n

# pseudo filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=n
CONFIG_UEVENT_HELPER=n
# containerd's snapshotter (the CloudWatch agent, pulled at boot when enabled)
CONFIG_OVERLAY_FS=y

# namespaces: LinuxKit services (runc needs /proc/self/setgroups, which only exists with user namespaces)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_TIME_NS=n

# seccomp: dhcpcd privsep
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# cgroup v2 for containerd/runc; device control through BPF
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# networking core
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_SYN_COOKIES=y
CONFIG_IPV6=y
CONFIG_IPV6_SIT=n
CONFIG_PACKET=y
CONFIG_WIRELESS=n

# the NAT: conntrack + nftables masquerade (init/natkit-init), IPv4 and IPv6 tables.
# NETFILTER_ADVANCED=y keeps the unlisted netfilter options n instead of their default m.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# Jool (NAT64): its netfilter hooks come after IPv4/IPv6 defragmentation; it also builds an iptables target (x_tables)
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NETFILTER_XTABLES=y
