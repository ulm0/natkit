# natkit kernel options for EC2 x86_64 (Nitro), after natkit.config (kernel/build.sh)

# allnoconfig is uniprocessor on x86
CONFIG_SMP=y
# Nitro is KVM-based: kvmclock, paravirt spinlocks, x2APIC (instances with more than 255 vCPUs)
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
# not for 32-bit binaries
CONFIG_IA32_EMULATION=n
# the UKI's kernel is the bzImage itself (its EFI stub; no --decompress-kernel)
CONFIG_EFI_MIXED=n

# the legacy COM1 UART (ttyS0)
CONFIG_PNP=y
CONFIG_SERIAL_8250_PNP=y

# clock: the CMOS RTC (EFI's isn't used on x86)
CONFIG_RTC_DRV_CMOS=y
