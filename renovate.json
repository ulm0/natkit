{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "the kernel (github.com/ulm0/lk-kernel, by version and digest) and the Jool modules tagged with its version, in one PR",
      "managerFilePatterns": [
        "/^natkit\\.yml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/ulm0/lk-kernel:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "- ghcr\\.io/ulm0/natkit/jool:(?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"
      ],
      "depNameTemplate": "ghcr.io/ulm0/lk-kernel",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Alpine in the Makefile (init/Dockerfile's is Renovate's dockerfile manager)",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ALPINE := (?<depName>alpine):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "CloudWatch agent, pulled at boot",
      "managerFilePatterns": [
        "/^init/natkit-cwagent$/"
      ],
      "matchStrings": [
        "IMAGE=(?<depName>public\\.ecr\\.aws/cloudwatch-agent/cloudwatch-agent):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)b(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "the kernel stays on its LTS series; a new series is a deliberate change (kernel config review, Jool support)",
      "matchDepNames": [
        "ghcr.io/ulm0/lk-kernel"
      ],
      "allowedVersions": "/^6\\.18\\./"
    },
    {
      "description": "Alpine: init image and Makefile together",
      "matchDepNames": [
        "alpine"
      ],
      "groupName": "alpine"
    },
    {
      "description": "Jool: the version and checksum live in init/Dockerfile and jool/Dockerfile, bumped by hand together",
      "matchDepNames": [
        "NICMx/Jool"
      ],
      "enabled": false
    }
  ]
}
