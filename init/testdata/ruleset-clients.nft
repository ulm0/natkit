flush ruleset
table ip natkit {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth1" meta l4proto { tcp, udp } masquerade to :1024-61000 comment "NAT routing rule installed by natkit"
		oifname "eth1" masquerade
	}
}
table inet natkit {
	set clients4 { type ipv4_addr; flags interval; auto-merge; elements = { 10.0.0.0/16, 10.0.1.0/24 } }
	set clients6 { type ipv6_addr; flags interval; auto-merge; elements = { 2600:1f18:aaaa:bb00::/56 } }
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		iifname "lo" accept
		meta l4proto icmp accept
		meta l4proto ipv6-icmp accept
		udp dport 68 accept
		udp dport 546 accept
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state invalid drop
		ct state established,related accept
		ip saddr @clients4 accept
		ip6 saddr @clients6 accept
	}
	chain prerouting {
		type filter hook prerouting priority raw; policy accept;
		ip6 daddr 64:ff9b::/96 ip6 saddr != @clients6 drop
	}
}
