#!/bin/sh
# natkit-cwagent (service): the CloudWatch agent, only when natkit-init wrote its config (user-data cwagent_enabled).
# Not in the image: it would sit in RAM (~150+ MB unpacked) on every NAT instance. Pulled by digest through the
# system containerd (the host's ctr, bound in) into its own namespace, run in the host network with the config at
# /etc/cwagentconfig, the agent image's container config directory. Restarted if it exits.
set -u
CONF=/run/natkit/cwagent
IMAGE=public.ecr.aws/cloudwatch-agent/cloudwatch-agent:1.300074.1b2005@sha256:f6ce19de7f57fe9c536eb01dbebfb4c997fa053fa891d02711858642dda8a3f4
ctr() { /usr/bin/ctr -n natkit "$@"; }
# say <message>: to the serial console (memlogd's log isn't reachable from outside) and stderr
say() { echo "natkit-cwagent: $*" | tee -a "${NATKIT_CONSOLE:-/dev/console}" >&2; }

[ -f "$CONF/cwagentconfig.json" ] || { echo "natkit-cwagent: not enabled"; exit 0; }

until err=$(ctr image pull "$IMAGE" 2>&1 >/dev/null); do
	say "pull failed, retrying: $(printf '%s' "$err" | tail -n 1)"
	sleep 10
done
say "pulled $IMAGE"
while :; do
	ctr task kill -s KILL cwagent 2>/dev/null
	ctr container rm cwagent 2>/dev/null
	# ctr run, unlike a LinuxKit service, gives the container no resolv.conf: the host's (dhcpcd's), read-only
	# its output goes to memlogd as before; the last lines also go on the console when it exits
	last=$(ctr run --rm --net-host --mount "type=bind,src=$CONF,dst=/etc/cwagentconfig,options=rbind:ro" \
		--mount "type=bind,src=/etc/resolv.conf,dst=/etc/resolv.conf,options=rbind:ro" "$IMAGE" cwagent 2>&1 |
		tee /dev/stderr | tail -n 8)
	say "agent exited, restarting; its last output:"
	printf '%s\n' "$last" | while IFS= read -r l; do say "  $l"; done
	sleep 10
done
