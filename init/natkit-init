#!/bin/sh
# natkit-init (onboot, every boot): fck-nat's setup (github.com/AndrewGuenther/fck-nat, service/fck-nat.sh) without
# systemd or aws-cli. EC2 user-data (IMDSv2) is YAML with fck-nat's /etc/fck-nat.conf keys, all optional:
#
#   eip_id: eipalloc-0123                 # associate this EIP with the primary ENI (after eni_id's ENI is attached)
#   eni_id: eni-0123                      # static ENI (the private route tables' target): attach as device 1 (taking
#                                         #   it over from an instance that holds it), turn off the primary ENI's
#                                         #   source/dest check
#   nat64: false                          # no NAT64 (default: on)
#   interface: eth0                       # public interface, if not the primary ENI's (ignored with eni_id)
#   client_cidrs: [10.0.0.0/16]           # only these sources may open connections through the NAT (default: any)
#   ip_local_port_range: "1024 65535"     # sysctl tuning, as in fck-nat
#   nf_conntrack_max: 262144
#   nf_conntrack_buckets: 65536
#   nf_conntrack_tcp_timeout_established: 86400
#   tcp_keepalive_time: 600
#   tcp_max_syn_backlog: 4096
#   cwagent_enabled: true                 # CloudWatch agent (natkit-cwagent) with the JSON config in this
#   cwagent_cfg_param_name: /natkit/cw    #   SSM parameter
#   console_password: /natkit/root-hash   # SSM parameter: root's crypt hash for the serial console getty
#
# AWS calls (EC2, SSM) are signed with the instance role by curl --aws-sigv4. In order: nftables masquerade out of
# the public interface, forwarding and tuning sysctls, NAT64 (Jool, pool6 64:ff9b::/96), no more module loading,
# the SSM parameters, and only then the static ENI and the EIP: an instance whose setup fails takes neither.
# One result line goes to the serial console:
#   natkit: ready, public <if> private <if>, eip <id>|none, nat64 on|off, cwagent on|off
#   natkit: FAIL <reason>
# A failed instance also reports itself unhealthy to its Auto Scaling group, if it has one (and the permission to):
# the group replaces it, and keeps the instance it was going to replace.
set -eu

IMDS=${NATKIT_IMDS:-http://169.254.169.254/latest} # overrides: test/init.sh
CONSOLE=${NATKIT_CONSOLE:-/dev/console}
RUN=/run/natkit
UD=$RUN/user-data
JOOL_POOL6=64:ff9b::/96
console() { echo "natkit: $*" >"$CONSOLE" 2>/dev/null || :; }
log() { echo "natkit-init: $*"; }
die() {
	echo "natkit-init: $*" >&2
	console "FAIL $*"
	unhealthy
	exit 1
}

umask 022
mkdir -p "$RUN"
# the getty binds this file: it must exist even if the setup fails below, or there'd be no console to see why.
# Root stays locked until console_password replaces it.
(umask 077 && echo 'root:*::0:99999:7:::' >"$RUN/getty.shadow")

imds() { curl -fsS -m 5 -H "X-aws-ec2-metadata-token: $T" "$IMDS/$1"; }
# instance role credentials, fetched once (natkit-init is done long before they expire); status 1 without a role
creds() {
	[ -z "${ak:-}" ] || return 0
	profile=$(imds meta-data/iam/security-credentials/ 2>/dev/null) || return 1
	c=$(imds "meta-data/iam/security-credentials/$profile") || return 1
	ak=$(echo "$c" | yq -p json .AccessKeyId)
	sk=$(echo "$c" | yq -p json .SecretAccessKey)
	st=$(echo "$c" | yq -p json .Token)
}
# signed <service> <curl args...>: curl with SigV4; the credentials go in on stdin (-K -), not on the command line,
# where /proc would show them
signed() {
	svc=$1
	shift
	printf 'user = "%s:%s"\nheader = "x-amz-security-token: %s"\n' "$ak" "$sk" "$st" |
		curl -K - -sS --aws-sigv4 "aws:amz:$region:$svc" "$@"
}
# unhealthy (die's): tells the instance's Auto Scaling group to replace it. An instance refresh waits for a healthy
# replacement before it terminates the old instance, and EC2's own health check passes on an instance whose setup
# failed: without this the group would terminate the one instance that routes. Best effort: no group, no role or no
# autoscaling:SetInstanceHealth is not an error.
unhealthy() {
	[ -n "${iid:-}" ] && creds || return 0
	signed autoscaling -f -m 10 -o /dev/null --data-urlencode Action=SetInstanceHealth --data-urlencode Version=2011-01-01 \
		--data-urlencode "InstanceId=$iid" --data-urlencode HealthStatus=Unhealthy \
		--data-urlencode ShouldRespectGracePeriod=false "${NATKIT_AUTOSCALING:-https://autoscaling.$region.amazonaws.com/}" 2>/dev/null &&
		log "reported unhealthy to the Auto Scaling group" || :
}

# IMDSv2 session token (hop limit 1 is enough: this container shares the host network)
T=
for _ in $(seq 30); do
	T=$(curl -fsS -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' "$IMDS/api/token") && break
	sleep 1
done
[ -n "$T" ] || die "no instance metadata service"
region=$(imds meta-data/placement/region)
iid=$(imds meta-data/instance-id)
mac=$(imds meta-data/mac)
primary_eni=$(imds "meta-data/network/interfaces/macs/$mac/interface-id")

imds user-data >"$UD" 2>/dev/null || : # 404: no user-data
[ -s "$UD" ] || echo '{}' >"$UD"
yq -e 'tag == "!!map"' "$UD" >/dev/null 2>&1 || die "user-data is not a YAML map"

# every key known (a typo would silently do nothing), every value in its expected shape
KEYS="eip_id eni_id interface client_cidrs ip_local_port_range nf_conntrack_max nf_conntrack_buckets nf_conntrack_tcp_timeout_established
tcp_keepalive_time tcp_max_syn_backlog cwagent_enabled cwagent_cfg_param_name console_password nat64"
for k in $(yq 'keys | .[]' "$UD"); do
	echo " $KEYS " | tr '\n' ' ' | grep -q " $k " || die "user-data: unknown key '$k'"
done
val() { K=$1 yq '.[strenv(K)] // "" | tostring' "$UD"; }
check() { # check <key> <extended regex>: the value, if set, must match
	v=$(val "$1")
	[ -z "$v" ] || echo "$v" | grep -qxE "$2" || die "user-data: $1: bad value '$v'"
}
check eip_id 'eipalloc-[0-9a-f]+'
check eni_id 'eni-[0-9a-f]+'
check interface '[A-Za-z0-9._-]{1,15}'
check ip_local_port_range '[0-9]+[ 	]+[0-9]+'
for k in nf_conntrack_max nf_conntrack_buckets nf_conntrack_tcp_timeout_established tcp_keepalive_time tcp_max_syn_backlog; do
	check "$k" '[0-9]+'
done
check cwagent_enabled 'true|false'
# val's '// ""' reads false as unset: nat64 is the one key where false means something
yq -e '.nat64 == null or .nat64 == true or .nat64 == false' "$UD" >/dev/null 2>&1 || die "user-data: nat64: bad value '$(yq .nat64 "$UD")'"
check cwagent_cfg_param_name '[A-Za-z0-9_./-]+'
check console_password '[A-Za-z0-9_./-]+'
# client_cidrs: a non-empty list of CIDRs, split by family for nftables (which checks the IPv6 addresses itself).
# IPv4 octets without leading zeros: nft would read 010.0.0.0/8 as octal, 8.0.0.0/8.
yq -e '.client_cidrs == null or ((.client_cidrs | tag) == "!!seq" and (.client_cidrs | length) > 0)' "$UD" >/dev/null 2>&1 ||
	die "user-data: client_cidrs: not a list of CIDRs"
clients=$(yq '.client_cidrs != null' "$UD")
c4='' c6='' o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
set -f # split the list on whitespace, but never expand a * in it
for c in $(yq '.client_cidrs // [] | .[] | tostring' "$UD"); do
	if echo "$c" | grep -qxE "($o\\.){3}$o/(3[0-2]|[12]?[0-9])"; then
		c4="$c4${c4:+, }$c"
	elif echo "$c" | grep -qxE '[0-9A-Fa-f:]*:[0-9A-Fa-f:]*/(12[0-8]|1[01][0-9]|[1-9]?[0-9])'; then
		c6="$c6${c6:+, }$c"
	else
		die "user-data: client_cidrs: bad value '$c'"
	fi
done
set +f
# blank entries split to no words at all: a list of them would silently forward nothing
[ "$clients" != true ] || [ -n "$c4$c6" ] || die "user-data: client_cidrs: not a list of CIDRs"

# ifname <mac>: the interface with this MAC (no udev here: no ENI-ID altnames as on Amazon Linux)
ifname() {
	for d in /sys/class/net/*; do
		[ "$(cat "$d/address" 2>/dev/null)" = "$1" ] && echo "${d##*/}" && return 0
	done
	return 1
}
public=$(ifname "$mac") || die "no interface with the primary ENI's MAC $mac"
private=$public

# ec2 <Action> [Name=value ...]: an EC2 Query API call. The response XML on stdout; on an error the AWS error code
# and message on stderr, and status 1.
ec2() {
	action=$1
	shift
	creds || die "$action: no instance profile"
	n=$#
	for p; do set -- "$@" --data-urlencode "$p"; done
	shift "$n"
	code=$(signed ec2 -m 20 -o "$RUN/ec2.out" -w '%{http_code}' --data-urlencode "Action=$action" \
		--data-urlencode Version=2016-11-15 "$@" "${NATKIT_EC2:-https://ec2.$region.amazonaws.com/}") || code=000
	case $code in
	2??) cat "$RUN/ec2.out" ;;
	*)
		echo "natkit-init: $action: HTTP $code $(yq -p xml '.Response.Errors.Error | .Code + ": " + .Message' "$RUN/ec2.out" 2>/dev/null)" >&2
		return 1
		;;
	esac
}

# retry <tries> <what> <command...>: the instance role can take a few seconds to work after launch
retry() {
	tries=$1 what=$2
	shift 2
	i=0
	# the last try's stderr (curl's or the AWS error) goes on the console with the failure
	until "$@" >/dev/null 2>"$RUN/retry.err"; do
		i=$((i + 1))
		[ "$i" -lt "$tries" ] || die "$what failed: $(tr '\n' ' ' <"$RUN/retry.err")"
		sleep 3
	done
}

# ssm <parameter> <what>: the decrypted value
ssm() {
	creds || die "$2: no instance profile"
	body=$(N=$1 yq -n -o json -I0 '{"Name": strenv(N), "WithDecryption": true}')
	for i in $(seq 10); do
		resp=$(signed ssm -f -m 10 -H 'Content-Type: application/x-amz-json-1.1' \
			-H 'X-Amz-Target: AmazonSSM.GetParameter' -d "$body" "${NATKIT_SSM:-https://ssm.$region.amazonaws.com/}") && break
		[ "$i" = 10 ] && die "ssm: can't read $1 for $2"
		sleep 3
	done
	echo "$resp" | yq -p json '.Parameter.Value'
}

# eni_mac <eni>: the MAC of an ENI attached to this instance
eni_mac() {
	for m in $(imds meta-data/network/interfaces/macs/); do
		m=${m%/}
		[ "$(imds "meta-data/network/interfaces/macs/$m/interface-id")" = "$1" ] && echo "$m" && return 0
	done
	return 1
}

# the public interface: the primary ENI's, or user-data's `interface` (ignored with eni_id)
eni_id=$(val eni_id)
if [ -z "$eni_id" ] && [ -n "$(val interface)" ]; then
	public=$(val interface)
	private=$public
	[ -e "/sys/class/net/$public" ] || die "interface: no interface $public"
fi

# client_cidrs: only these sources may open a connection through the NAT; replies to it always pass. Without it
# the security group alone decides who may (as before). NAT64 is gated in prerouting, at raw priority: Jool takes
# the client's IPv6 packet at prerouting priority -75 and sends the translated IPv4 one itself, so neither reaches
# the forward chain. auto-merge: overlapping CIDRs would otherwise be a conflicting-intervals error.
fwd_policy=accept fwd='' sets='' pre=''
if [ "$clients" = true ]; then
	fwd_policy=drop
	e4='' e6='' # not ${c4:+...}: the set's braces would close the expansion
	[ -z "$c4" ] || e4="elements = { $c4 }"
	[ -z "$c6" ] || e6="elements = { $c6 }"
	sets="set clients4 { type ipv4_addr; flags interval; auto-merge; $e4 }
	set clients6 { type ipv6_addr; flags interval; auto-merge; $e6 }"
	fwd="ct state established,related accept
		ip saddr @clients4 accept
		ip6 saddr @clients6 accept"
	pre="chain prerouting {
		type filter hook prerouting priority raw; policy accept;
		ip6 daddr $JOOL_POOL6 ip6 saddr != @clients6 drop
	}"
fi

# masquerade out of the public interface; one transaction, so there's no moment without the rule. TCP and UDP to
# ports 1024-61000: Jool's NAT64 sessions use 61001-65535 of the same address, and masquerade otherwise keeps a
# client's source port, which can be one of those.
# The instance itself accepts nothing new (it has no listening service; this keeps it so): replies, ICMP (path MTU,
# IPv6 neighbour discovery) and DHCP only. Forwarded: packets conntrack can't place in a connection are dropped
# (they'd skip the masquerade and leave with a private source), and new connections from outside client_cidrs.
# NAT64 packets are taken by Jool in prerouting, before this input chain.
nft -f - <<EOF || die "nftables"
flush ruleset
table ip natkit {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "$public" meta l4proto { tcp, udp } masquerade to :1024-61000 comment "NAT routing rule installed by natkit"
		oifname "$public" masquerade
	}
}
table inet natkit {
	$sets
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		iifname "lo" accept
		meta l4proto icmp accept
		meta l4proto ipv6-icmp accept
		udp dport 68 accept
		udp dport 546 accept
	}
	chain forward {
		type filter hook forward priority filter; policy $fwd_policy;
		ct state invalid drop
		$fwd
	}
	$pre
}
EOF
log "masquerading out of $public${c4:+, clients $c4}${c6:+, clients $c6}"

# forwarding, rp_filter and hardening (init/sysctl.conf): a key that doesn't take is a failed boot, not a NAT that
# quietly doesn't forward. Written straight to /proc/sys: busybox's `sysctl -p` exits 0 on a bad key. Under
# test/init.sh only the net.* keys (the container's own): the rest are the docker host's kernel.
while IFS=' =' read -r k v; do
	case $k in '' | '#'*) continue ;; esac
	[ -n "${NATKIT_IMDS:-}" ] && [ "${k#net.}" = "$k" ] && continue
	echo "$v" >"/proc/sys/$(echo "$k" | tr . /)" || die "sysctl $k=$v"
done </etc/natkit/sysctl.conf

# tuning, as fck-nat: only what user-data sets, except the conntrack table. The kernel sizes it for a host (about
# 7 000 flows under 1 GiB, 65 536 up to 4 GiB) and a NAT that fills it drops every new connection ("nf_conntrack:
# table full"). Default: one flow per 8 kB of RAM (a full table is about 4% of memory), a quarter as many buckets.
# Not under test/init.sh: the table is the docker host's.
s() { [ -z "$2" ] || sysctl -q -w "$1=$2" || die "sysctl $1=$2"; }
cmax=$(val nf_conntrack_max)
b=$(val nf_conntrack_buckets)
if [ -z "${NATKIT_IMDS:-}" ]; then
	[ -n "$cmax" ] || cmax=$(($(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) / 8))
	[ -n "$b" ] || b=$((cmax / 4))
fi
s net.ipv4.ip_local_port_range "$(val ip_local_port_range)"
s net.netfilter.nf_conntrack_max "$cmax"
s net.netfilter.nf_conntrack_tcp_timeout_established "$(val nf_conntrack_tcp_timeout_established)"
s net.ipv4.tcp_keepalive_time "$(val tcp_keepalive_time)"
s net.ipv4.tcp_max_syn_backlog "$(val tcp_max_syn_backlog)"
[ -z "$b" ] || echo "$b" >/sys/module/nf_conntrack/parameters/hashsize || die "nf_conntrack_buckets=$b"

# EC2's connection-tracking allowance for this instance type: flows past it are dropped before they reach natkit.
# Read now, before the ENI brings the clients' traffic, so it's the whole allowance, and after the tuning, so the
# kernel's table next to it is the one in use. Not as "natkit: ": that prefix is the one result line.
a=$(ethtool -S "$public" 2>/dev/null | awk '$1 == "conntrack_allowance_available:" { print $2 }')
if [ -n "$a" ]; then
	l="EC2 conntrack allowance $a, nf_conntrack_max $(cat /proc/sys/net/netfilter/nf_conntrack_max)"
	log "$l"
	echo "natkit-init: $l" >"$CONSOLE" 2>/dev/null || :
fi

# NAT64: Jool's modules (the jool image in natkit.yml's init) and its userspace tool (this image), same version.
# With client_cidrs, address-dependent filtering: by default Jool lets any IPv4 host reach a client's mapping
# (pool4 address and port); with it, only the hosts the client contacted, as the IPv4 masquerade does.
nat64=off
m=/lib/modules/$(uname -r)/extra
if [ "$(yq '.nat64 == false' "$UD")" = true ]; then
	log "NAT64: off in user-data"
elif [ -f "$m/jool.ko" ]; then
	if { grep -q '^jool_common ' /proc/modules || insmod "$m/jool_common.ko"; } &&
		{ grep -q '^jool ' /proc/modules || insmod "$m/jool.ko"; } &&
		jool instance flush && jool instance add --netfilter --pool6 "$JOOL_POOL6" &&
		{ [ "$clients" != true ] || jool global update address-dependent-filtering true; }; then
		nat64=on
		log "NAT64 on, pool6 $JOOL_POOL6"
	else
		log "NAT64: Jool failed, skipped" # as fck-nat: the IPv4 NAT works without it
	fi
else
	log "NAT64: no Jool modules for $(uname -r), skipped"
fi
# nothing loads a module after this (drivers and netfilter are built in): no more kernel code until reboot.
# Not under test/init.sh, where it would lock the docker host's kernel.
[ -n "${NATKIT_IMDS:-}" ] || sysctl -q -w kernel.modules_disabled=1 || die "sysctl kernel.modules_disabled"

# CloudWatch agent: natkit-cwagent (a service) runs it when this config exists
cwagent=off
rm -rf "$RUN/cwagent"
if [ "$(val cwagent_enabled)" = true ]; then
	p=$(val cwagent_cfg_param_name)
	[ -n "$p" ] || die "cwagent_enabled needs cwagent_cfg_param_name"
	mkdir -p "$RUN/cwagent"
	ssm "$p" cwagent_cfg_param_name >"$RUN/cwagent/cwagentconfig.json"
	yq -p json -e 'tag == "!!map"' "$RUN/cwagent/cwagentconfig.json" >/dev/null 2>&1 || die "cwagent: $p is not a JSON object"
	cwagent=on
fi

# serial console root login (getty): a crypt(3) hash from SSM (openssl passwd -6), else root stays locked
hash='*'
cp=$(val console_password)
if [ -n "$cp" ]; then
	hash=$(ssm "$cp" console_password)
	case $hash in '$'*) ;; *) die "console_password: $cp is not a crypt hash (openssl passwd -6)" ;; esac
fi
[ "$hash" = '*' ] || (umask 077 && echo "root:$hash::0:99999:7:::" >"$RUN/getty.shadow") # empty lastchg: 0 would force a password change

# The static ENI and the EIP, last: everything that can fail has not, so an instance whose setup failed never takes
# the route tables' traffic or the address.
if [ -n "$eni_id" ]; then
	log "turning off $primary_eni's source/dest check"
	retry 10 "ModifyNetworkInterfaceAttribute $primary_eni" ec2 ModifyNetworkInterfaceAttribute \
		"NetworkInterfaceId=$primary_eni" SourceDestCheck.Value=false
	if ! eni_mac "$eni_id" >/dev/null; then
		# An ASG replacement: the old instance still holds the ENI. Take it over (a forced detach: the old instance
		# is on its way out and needn't agree), so egress stops for the detach and attach only, not for the old
		# instance's shutdown or this one's boot. Without the permissions to, wait for the ENI as fck-nat does;
		# fck-nat waits forever, natkit gives up after 15 min so the console (getty) shows the failure.
		att=$(ec2 DescribeNetworkInterfaces "NetworkInterfaceId.1=$eni_id" 2>"$RUN/retry.err" |
			yq -p xml '.DescribeNetworkInterfacesResponse.networkInterfaceSet.item.attachment.attachmentId // ""') || att=''
		if [ -n "$att" ]; then
			log "taking $eni_id over from its instance ($att)"
			ec2 DetachNetworkInterface "AttachmentId=$att" Force=true >/dev/null || log "can't detach $att: waiting for it"
		elif [ -s "$RUN/retry.err" ]; then
			log "can't look up $eni_id's attachment: waiting for it"
		fi
		log "attaching $eni_id"
		i=0
		until ec2 AttachNetworkInterface "InstanceId=$iid" "NetworkInterfaceId=$eni_id" DeviceIndex=1 >/dev/null 2>"$RUN/retry.err"; do
			i=$((i + 1))
			[ "$i" -lt 450 ] || die "AttachNetworkInterface $eni_id: still failing after 15 min: $(tr '\n' ' ' <"$RUN/retry.err")"
			# the first refusal on the console: a wrong eni_id or a missing permission would otherwise show nothing
			# there for 15 min. (In a handover it's the old instance's detach, still in progress.)
			[ "$i" != 1 ] || echo "natkit-init: waiting for $eni_id: $(tr '\n' ' ' <"$RUN/retry.err")" >"$CONSOLE" 2>/dev/null || :
			[ $((i % 15)) != 1 ] || log "waiting for $eni_id to attach: $(tr '\n' ' ' <"$RUN/retry.err")"
			sleep 2
		done
	fi
	i=0
	until emac=$(eni_mac "$eni_id") && private=$(ifname "$emac"); do
		i=$((i + 1))
		[ "$i" -lt 120 ] || die "$eni_id attached, but no interface for it after 2 min"
		sleep 1
	done
	ip link set dev "$private" up # its address comes from the dhcpcd service; forwarding doesn't need one
	log "$eni_id is $private"
fi

# the EIP last (fck-nat takes it first): a replacement instance waiting for the static ENI must not pull the EIP
# off the old instance, which is still the one routing
eip_id=$(val eip_id)
if [ -n "$eip_id" ]; then
	log "associating $eip_id with $primary_eni"
	retry 10 "AssociateAddress $eip_id" ec2 AssociateAddress "AllocationId=$eip_id" "NetworkInterfaceId=$primary_eni" AllowReassociation=true
fi

# rp_filter also per interface: the ENI attached just now has the defaults (conf/default), these make it explicit
for f in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 >"$f"; done
# a router on one interface would tell clients to bypass it (ICMP redirects); the kernel ORs all with each interface
for f in /proc/sys/net/ipv4/conf/*/send_redirects; do echo 0 >"$f"; done


console "ready, public $public private $private, eip ${eip_id:-none}, nat64 $nat64, cwagent $cwagent"
log "done"
